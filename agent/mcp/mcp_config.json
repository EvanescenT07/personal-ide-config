{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest",
        "--api-key",
        "${env:CONTEXT7_API_KEY}"
      ]
    },
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "graphifyy",
        "--with",
        "mcp",
        "python",
        "-m",
        "graphify.serve"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "stitch": {
      "disabled": false,
      "serverUrl": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${env:STITCH_API_KEY}"
      }
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.8.0",
        "mcp"
      ]
    },
    "flow-connector": {
      "command": "flow-auto-mcp"
    },
    "dart-mcp-server": {
      "$typeName": "exa.cascade_plugins_pb.CascadePluginCommandTemplate",
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "env": {}
    }
  }
}
